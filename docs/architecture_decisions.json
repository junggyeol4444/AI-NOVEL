      "role": "GUI, progress, approval screens"
    },
    {
      "id": "api",
      "zone": "deployment_pending",
      "tech": "FastAPI",
      "role": "Authenticated application boundary"
    },
    {
      "id": "orchestrator",
      "zone": "backend",
      "tech": "Python",
      "role": "Plan, write, review, memory-update workflow"
    },
    {
      "id": "reference_analyzer",
      "zone": "backend",
      "tech": "Python parsers",
      "role": "Extract only structural profiles from permitted reference works"
    },
    {
      "id": "planner",
      "zone": "backend",
      "tech": "Python",
      "role": "Novel Bible first; reference patterns second"
    },
    {
      "id": "writer",
      "zone": "backend",
      "tech": "AI adapter",
      "role": "Generate original scenes from approved context"
    },
    {
      "id": "quality",
      "zone": "backend",
      "tech": "Python checkers",
      "role": "Continuity, logic, style, repetition, similarity checks"
    },
    {
      "id": "memory",
      "zone": "backend",
      "tech": "PostgreSQL + pgvector",
      "role": "Canonical facts and retrieval"
    },
    {
      "id": "queue",
      "zone": "infrastructure",
      "tech": "Celery + Redis",
      "role": "Async long-running jobs"
    },
    {
      "id": "publishing",
      "zone": "backend",
      "tech": "EPUB3 + platform adapters",
      "role": "Generate files; external publication requires approval"
    },
    {
      "id": "provider",
      "zone": "external",
      "tech": "TBD AI API",
      "role": "AI inference only with user-approved account and budget"
    }
  ],
  "connections": [
    {
      "from": "desktop",
      "to": "api",
      "via": "HTTP(S) JSON; loopback only if local"
    },
    {
      "from": "api",
      "to": "orchestrator",
      "via": "Python service"
    },
    {
      "from": "orchestrator",
      "to": "reference_analyzer",
      "via": "Python service"
    },
    {
      "from": "reference_analyzer",
      "to": "memory",
      "via": "Reference Profile persistence"
    },
    {
      "from": "orchestrator",
      "to": "planner",
      "via": "Python service"
    },
    {
      "from": "planner",
      "to": "memory",
      "via": "Novel Bible + profile retrieval"
    },
    {
      "from": "orchestrator",
      "to": "writer",
      "via": "Scene plan and filtered context"
    },
    {
      "from": "writer",
      "to": "provider",
      "via": "Approved AI adapter"
    },
    {
      "from": "orchestrator",
      "to": "quality",
      "via": "Draft quality gate"
    },
    {
      "from": "quality",
      "to": "memory",
      "via": "Read canonical facts; persist reports"
    },
    {
      "from": "orchestrator",
      "to": "memory",
      "via": "Commit accepted manuscript + memory delta"
    },
    {
      "from": "orchestrator",
      "to": "queue",
      "via": "Celery task submission"
    },
    {
      "from": "orchestrator",
      "to": "publishing",
      "via": "Approved manuscript only"
    }
